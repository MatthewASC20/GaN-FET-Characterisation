# Python bytecode and build artefacts
__pycache__/
*.pyc
*.egg-info/
build/
dist/

# Virtual environments
.venv/
venv/
env/

# Tool caches
.mplconfig/
.mypy_cache/
.pytest_cache/
.ruff_cache/

# OS cruft
.DS_Store
._*

# Secrets — never commit the Google service-account key
credentials.json

# Runtime state (live tree)
settings.json
screenshots/
reports/
exports/

# Databases and logs — generated at run time, never source
*.db
*.db-wal
*.db-shm
*.log
logs/
